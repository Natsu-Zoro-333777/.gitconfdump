configuration{
  modi: ["drun", "window", "run"];
  icon-theme: "Vivid-Dark-Icons";
  show-icons: true;
  terminal: "ghostty";
  drun-display-format: "{icon} {name}";
  location: 0;
  disable-history: false;
  sidebar-mode: false;
  display-drun:"󰶻";
  display-run:"󰶻";
  display-window:"󱂬";

  kb-accept-entry: "Control+z,Control+y,Return,KP_Enter";

}


@theme "theme.rasi"
